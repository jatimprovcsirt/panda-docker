# Copy to .env and fill in. Never commit the filled-in version.

# --- image ------------------------------------------------------------------
PANDA_IMAGE=harbor.jatimprov.go.id/panda/panda-docker:0.1.0

# --- key provider -----------------------------------------------------------
# The container never holds a key of its own. It reads from the provider, which
# is what lets it be discarded and replaced without ceremony.
PANDA_VAULT_URL=https://vault.internal:8200
PANDA_VAULT_ROLE_ID=
PANDA_VAULT_SECRET_ID=
PANDA_VAULT_MOUNT_PATH=secret

# Separate from the encryption keys on purpose: a leaked index key exposes no
# plaintext, and a leaked encryption key cannot be used to forge an index.
# Generate with: openssl rand -base64 32
PANDA_INDEX_KEY=
